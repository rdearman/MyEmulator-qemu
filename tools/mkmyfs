#!/usr/bin/env python3
"""Build a raw MyFS v1 image for the MyEmulator floppy device."""
import argparse
import re
import sys
from pathlib import Path

SECTOR = 256
HEADER_SECTOR = 1
DIRECTORY_SECTOR = 2
DIRECTORY_ENTRIES = 16
ENTRY_SIZE = 16
DATA_SECTOR = 3
COMMAND_LOAD_LIMIT = 0x1c00
MAGIC = b"MYFS"
VERSION = 1


def die(message):
    raise ValueError(message)


def canonical_name(name):
    name = name.upper()
    if not re.fullmatch(r"[A-Z0-9_$-]{1,8}(\.[A-Z0-9_$-]{1,3})?", name):
        die(f"invalid 8.3 filename: {name!r}")
    base, dot, ext = name.partition(".")
    return (base.ljust(8) + ext.ljust(3)).encode("ascii")


def parse_file(spec):
    if "=" not in spec:
        die(f"--file requires NAME=PATH: {spec!r}")
    name, path = spec.split("=", 1)
    if not name or not path:
        die(f"--file requires NAME=PATH: {spec!r}")
    return canonical_name(name), Path(path)


def build(args):
    if args.sectors < DATA_SECTOR:
        die("disk must contain at least three sectors")
    boot = Path(args.boot).read_bytes()
    if len(boot) > SECTOR:
        die(f"boot sector is {len(boot)} bytes; maximum is {SECTOR}")

    files = []
    names = set()
    for spec in args.file:
        name, path = parse_file(spec)
        if name in names:
            die(f"duplicate filename: {name.decode('ascii')}")
        names.add(name)
        data = path.read_bytes()
        if len(data) > 0xffff:
            die(f"{path}: file is too large for the 16-bit MyFS size field")
        if name == b"COMMAND COM" and len(data) > COMMAND_LOAD_LIMIT:
            die(f"{path}: COMMAND.COM exceeds the 0x{COMMAND_LOAD_LIMIT:x}-byte shell area")
        files.append((name, data))
    if len(files) > DIRECTORY_ENTRIES:
        die(f"too many files; directory capacity is {DIRECTORY_ENTRIES}")

    image = bytearray(args.sectors * SECTOR)
    image[:len(boot)] = boot
    image[SECTOR:2 * SECTOR] = bytes(SECTOR)
    header = bytearray(SECTOR)
    header[0:4] = MAGIC
    header[4] = VERSION
    header[5] = 16
    header[6:8] = DIRECTORY_SECTOR.to_bytes(2, "little")
    header[8] = 1
    header[9] = ENTRY_SIZE
    header[10] = DIRECTORY_ENTRIES
    header[12:14] = DATA_SECTOR.to_bytes(2, "little")
    header[14:16] = args.sectors.to_bytes(2, "little")
    image[SECTOR:2 * SECTOR] = header

    next_sector = DATA_SECTOR
    directory = bytearray(SECTOR)
    for index, (name, data) in enumerate(files):
        sectors = max(1, (len(data) + SECTOR - 1) // SECTOR)
        if next_sector + sectors > args.sectors:
            die(f"disk full while placing {name.decode('ascii').rstrip()}")
        entry = index * ENTRY_SIZE
        directory[entry:entry + 11] = name
        directory[entry + 11] = 1
        directory[entry + 12:entry + 14] = next_sector.to_bytes(2, "little")
        directory[entry + 14:entry + 16] = len(data).to_bytes(2, "little")
        start = next_sector * SECTOR
        image[start:start + len(data)] = data
        next_sector += sectors
    image[DIRECTORY_SECTOR * SECTOR:(DIRECTORY_SECTOR + 1) * SECTOR] = directory
    Path(args.output).write_bytes(image)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--boot", required=True, help="sector-0 boot binary")
    parser.add_argument("--output", required=True, help="raw image to create")
    parser.add_argument("--sectors", type=int, default=5760,
                        help="image capacity in 256-byte sectors (default: 5760)")
    parser.add_argument("--file", action="append", default=[], metavar="NAME=PATH",
                        help="place a file using an 8.3 guest name")
    args = parser.parse_args(argv)
    try:
        if not 1 <= args.sectors <= 0xffff:
            die("--sectors must be between 1 and 65535")
        build(args)
    except (OSError, ValueError) as exc:
        print(f"mkmyfs: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
