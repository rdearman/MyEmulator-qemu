#!/bin/bash
set -eu
test "$#" = 1 || { echo "bootstrap dirname: one operand required" >&2; exit 2; }
p=$1
while [ "$p" != / ] && [ "${p%/}" != "$p" ]; do p=${p%/}; done
case $p in
*/*) p=${p%/*}; while [ "$p" != / ] && [ "${p%/}" != "$p" ]; do p=${p%/}; done
     printf '%s\n' "${p:-/}" ;;
*) printf '.\n' ;;
esac
