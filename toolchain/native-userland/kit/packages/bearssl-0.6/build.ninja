rule cc
  command = mkdir -p $objdir && rm -f $out.tmp && "$$REM_USERLAND_ROOT/bootstrap/native/chibicc-selfbuilt" -O0 -DBR_NO_ASM=1 -DBR_INT128=0 -Iinc -Isrc -c $in -o $out.tmp && mv -f $out.tmp $out
  description = CC BearSSL $in
rule archive
  command = rm -f $out.tmp && ar rcs $out.tmp $in && mv -f $out.tmp $out
  description = AR BearSSL $out
build bearssl_headers: phony inc/bearssl.h inc/bearssl_aead.h inc/bearssl_block.h inc/bearssl_ec.h inc/bearssl_hash.h inc/bearssl_hmac.h inc/bearssl_kdf.h inc/bearssl_pem.h inc/bearssl_prf.h inc/bearssl_rand.h inc/bearssl_rsa.h inc/bearssl_ssl.h inc/bearssl_x509.h src/config.h src/inner.h
build build/samu-obj/src/aead/ccm.o: cc src/aead/ccm.c | ../../bootstrap/native/chibicc-selfbuilt bearssl_headers
