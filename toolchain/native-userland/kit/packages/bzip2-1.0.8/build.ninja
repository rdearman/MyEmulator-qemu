cc = ../../bootstrap/native/chibicc-selfbuilt
ld = ld
ar = ar
reloc = ../../bootstrap/rem-reloc.ld

rule cc
  command = mkdir -p $directory && rm -f $out.tmp && $cc -D_FILE_OFFSET_BITS=64 -I. -c $in -o $out.tmp && mv -f $out.tmp $out
  description = CC bzip2 $in
rule archive
  command = rm -f $out.tmp && $ar rcs $out.tmp $in && mv -f $out.tmp $out
  description = AR bzip2 $out
rule link
  command = mkdir -p native/bin build && $rm -f $out.partial.o.tmp $out.tmp && ld -r -T $reloc -o $out.partial.o.tmp $in && mv -f $out.partial.o.tmp $out.partial.o && $cc -o $out.tmp $out.partial.o && mv -f $out.tmp $out
  description = LINK bzip2 $out
rule symlink
  command = rm -f $out.tmp && ln -s $target $out.tmp && mv -f $out.tmp $out
  description = LINK bzip2 alias $out

build build/obj/blocksort.o: cc blocksort.c
  directory = build/obj
build build/obj/huffman.o: cc huffman.c
  directory = build/obj
build build/obj/crctable.o: cc crctable.c
  directory = build/obj
build build/obj/randtable.o: cc randtable.c
  directory = build/obj
build build/obj/compress.o: cc compress.c
  directory = build/obj
build build/obj/decompress.o: cc decompress.c
  directory = build/obj
build build/obj/bzlib.o: cc bzlib.c
  directory = build/obj
build build/obj/bzip2.o: cc bzip2.c
  directory = build/obj
build build/obj/bzip2recover.o: cc bzip2recover.c
  directory = build/obj

build native/libbz2.a: archive build/obj/blocksort.o build/obj/huffman.o build/obj/crctable.o build/obj/randtable.o build/obj/compress.o build/obj/decompress.o build/obj/bzlib.o
build native/bin/bzip2: link build/obj/bzip2.o build/obj/blocksort.o build/obj/huffman.o build/obj/crctable.o build/obj/randtable.o build/obj/compress.o build/obj/decompress.o build/obj/bzlib.o
build native/bin/bzip2recover: link build/obj/bzip2recover.o
build native/bin/bunzip2: symlink native/bin/bzip2
  target = bzip2
build native/bin/bzcat: symlink native/bin/bzip2
  target = bzip2

default native/libbz2.a native/bin/bzip2 native/bin/bzip2recover native/bin/bunzip2 native/bin/bzcat
