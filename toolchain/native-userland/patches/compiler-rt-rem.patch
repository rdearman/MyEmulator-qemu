@@ -0,0 +1,38 @@
+#ifndef REM_COMPILER_RT_PORT_H
+#define REM_COMPILER_RT_PORT_H
+
+#define __inline inline
+
+static inline int rem_clz32(uint32_t value) {
+  int count = 0;
+  if (!value) return 32;
+  while (!(value & 0x80000000U)) {
+    value <<= 1;
+    count++;
+  }
+  return count;
+}
+
+static inline int rem_clz64(uint64_t value) {
+  uint32_t high = value >> 32;
+  return high ? rem_clz32(high) : 32 + rem_clz32((uint32_t)value);
+}
+
+static inline int rem_ctz32(uint32_t value) {
+  int count = 0;
+  if (!value) return 32;
+  while (!(value & 1U)) {
+    value >>= 1;
+    count++;
+  }
+  return count;
+}
+
+#define __builtin_clz rem_clz32
+#define __builtin_clzl rem_clz32
+#define __builtin_clzll rem_clz64
+#define __builtin_ctz rem_ctz32
+#define __builtin_ctzl rem_ctz32
+#define __builtin_expect(value, expected) (value)
+
+#endif
