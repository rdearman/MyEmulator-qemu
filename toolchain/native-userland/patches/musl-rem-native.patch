--- a/arch/myemulator2/src/thread/myemulator2/clone.S	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/myemulator2/src/thread/myemulator2/clone.S	2026-09-28 11:02:54.402247550 +0100
@@ -0,0 +1,87 @@
+/* __clone(func, stack, flags, arg, ptid, tls, ctid)
+ *
+ * C arguments are passed in r1-r7.  The Linux clone syscall receives
+ * flags,newsp,parent_tid,child_tid,tls in r2-r6 after r1 is loaded with the
+ * syscall number.  The child starts with r13=newsp, so its trampoline record
+ * must be written to the aligned top of the caller-supplied stack.
+ */
+.section .text
+.global __clone
+.hidden __clone
+.type __clone,@function
+__clone:
+	/* posix_spawn may supply a temporary child stack in the caller's own
+	 * frame while the parent is suspended by vfork.  Keep our saved parent
+	 * registers well below that record so the child cannot overwrite them. */
+	subi r13, r13, 128
+	sw r1, 0(r13)
+	sw r2, 4(r13)
+	sw r3, 8(r13)
+	sw r4, 12(r13)
+	sw r5, 16(r13)
+	sw r6, 20(r13)
+	sw r7, 24(r13)
+	sw r14, 28(r13)
+	sw r15, 32(r13)
+	sw r8, 36(r13)
+	sw r9, 40(r13)
+	sw r10, 44(r13)
+	sw r11, 48(r13)
+	sw r12, 52(r13)
+
+	/* Keep the caller-supplied child stack unchanged.  The vfork child
+	 * shares the parent's address space and musl deliberately points this
+	 * at a temporary stack in the posix_spawn frame.  Writing a trampoline
+	 * record below it can overwrite the suspended parent's frame.  Preserve
+	 * the function and argument in registers instead; copy_thread() copies
+	 * those registers into the child, while the parent path restores them
+	 * from our save area. */
+	lw r2, 4(r13)
+	/* REM's compiler reserves a 4092-byte positive-offset area in each
+	 * frame before its ordinary local frame.  A vfork child receives the
+	 * caller's temporary stack base, so move the child SP below that area;
+	 * otherwise the child's first prologue writes into the suspended
+	 * parent's posix_spawn frame. */
+	lui r11, 1
+	sub r3, r2, r11
+	lw r12, 0(r13)
+	lw r7, 12(r13)
+
+	/* clone(flags, newsp, parent_tid, child_tid, tls). */
+	lw r2, 8(r13)
+	lw r4, 16(r13)
+	lw r5, 20(r13)
+	lw r6, 24(r13)
+	li r1, 220
+	syscall 0
+	bne r1, r0, 1f
+
+	/* Child: kernel switched r13 to newsp and preserved r12/r7. */
+	add r1, r7, r0
+	jalr r12
+	add r2, r1, r0
+	li r1, 93
+	syscall 0
+	j 2f
+
+1:
+	/* Restore the caller's argument registers and stack. */
+	lw r1, 0(r13)
+	lw r2, 4(r13)
+	lw r3, 8(r13)
+	lw r4, 12(r13)
+	lw r5, 16(r13)
+	lw r6, 20(r13)
+	lw r7, 24(r13)
+	lw r14, 28(r13)
+	lw r15, 32(r13)
+	lw r8, 36(r13)
+	lw r9, 40(r13)
+	lw r10, 44(r13)
+	lw r11, 48(r13)
+	lw r12, 52(r13)
+	addi r13, r13, 128
+	jr r14
+
+2:
+	j 2b
--- a/arch/myemulator2/syscall_arch.h	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/myemulator2/syscall_arch.h	2026-10-06 13:49:49.245867375 +0100
@@ -0,0 +1,75 @@
+#define __SYSCALL_LL_E(x) \
+((union { long long ll; long l[2]; }){ .ll = x }).l[0], \
+((union { long long ll; long l[2]; }){ .ll = x }).l[1]
+#define __SYSCALL_LL_O(x) __SYSCALL_LL_E((x))
+
+#ifdef __chibicc__
+long __syscall0(long);
+long __syscall1(long, long);
+long __syscall2(long, long, long);
+long __syscall3(long, long, long, long);
+long __syscall4(long, long, long, long, long);
+long __syscall5(long, long, long, long, long, long);
+long __syscall6(long, long, long, long, long, long, long);
+#else
+/* MyEmulator2 syscall ABI: r1 is the syscall number/result and r2-r7 are
+ * the six Linux arguments.  Fixed-register variables preserve that ABI while
+ * allowing musl's architecture-independent syscall wrappers to be reused. */
+#define __MYEMU_SYSCALL __asm__ volatile ("syscall 0" : "+r"(r1) : \
+    "r"(r2), "r"(r3), "r"(r4), "r"(r5), "r"(r6), "r"(r7) : "memory")
+
+static inline long __syscall0(long n)
+{
+	register long r1 __asm__("r1") = n;
+	register long r2 __asm__("r2");
+	register long r3 __asm__("r3");
+	register long r4 __asm__("r4");
+	register long r5 __asm__("r5");
+	register long r6 __asm__("r6");
+	register long r7 __asm__("r7");
+	__MYEMU_SYSCALL;
+	return r1;
+}
+
+#define __MYEMU_SYSCALL_N(N) \
+static inline long __syscall##N(long n, \
+    long a, long b, long c, long d, long e, long f) \
+{ \
+    register long r1 __asm__("r1") = n; \
+    register long r2 __asm__("r2") = a; \
+    register long r3 __asm__("r3") = b; \
+    register long r4 __asm__("r4") = c; \
+    register long r5 __asm__("r5") = d; \
+    register long r6 __asm__("r6") = e; \
+    register long r7 __asm__("r7") = f; \
+    __MYEMU_SYSCALL; \
+    return r1; \
+}
+
+static inline long __syscall6(long, long, long, long, long, long, long);
+
+static inline long __syscall1(long n, long a)
+{
+	return __syscall6(n, a, 0, 0, 0, 0, 0);
+}
+static inline long __syscall2(long n, long a, long b)
+{
+	return __syscall6(n, a, b, 0, 0, 0, 0);
+}
+static inline long __syscall3(long n, long a, long b, long c)
+{
+	return __syscall6(n, a, b, c, 0, 0, 0);
+}
+static inline long __syscall4(long n, long a, long b, long c, long d)
+{
+	return __syscall6(n, a, b, c, d, 0, 0);
+}
+static inline long __syscall5(long n, long a, long b, long c, long d, long e)
+{
+	return __syscall6(n, a, b, c, d, e, 0);
+}
+
+__MYEMU_SYSCALL_N(6)
+#undef __MYEMU_SYSCALL_N
+#undef __MYEMU_SYSCALL
+#endif
--- a/build-native.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/build-native.sh	2026-10-06 23:17:00.693168529 +0100
@@ -0,0 +1,37 @@
+#!/bin/bash
+set -eu
+case $0 in */*) cd "${0%/*}" ;; esac
+CC=${CC:-chibicc}
+mkdir -p native
+objects=
+case ${1:-full} in
+seed) files="internal/floatscan stdlib/strtod" ;;
+full) files="\
+    crypt/crypt_blowfish crypt/crypt_sha512 internal/floatscan \
+    legacy/cuserid locale/catopen math/__rem_pio2_large misc/nftw \
+    misc/realpath misc/syslog multibyte/mbsnrtowcs \
+    network/getaddrinfo network/gethostbyname2_r network/getnameinfo \
+    network/lookup_name network/lookup_serv network/netlink \
+    network/res_send network/resolvconf process/posix_spawn process/system \
+    regex/glob signal/sigset stdio/fputws stdio/tempnam stdio/vfprintf \
+    stdlib/fcvt stdlib/strtod string/memmem string/strstr thread/sem_open \
+    time/timer_create time/wcsftime unistd/faccessat" ;;
+*) echo "Usage: build-native.sh [seed|full]" >&2; exit 1 ;;
+esac
+for file in $files; do
+    name=${file##*/}
+    echo "CC musl $file.c"
+    "$CC" -D_XOPEN_SOURCE=700 -Iarch/myemulator2 -Iarch/generic \
+        -Isrc/include -Isrc/internal -Inative-headers -Iinclude \
+        -c "src/$file.c" -o "native/$name.o"
+    objects="$objects native/$name.o"
+done
+as -o native/native_syscall.o arch/myemulator2/src/native_syscall.S
+ar rcs native/librem-runtime.a $objects native/native_syscall.o
+cp /usr/lib/libc.a native/libc.a
+ar rcs native/libc.a $objects native/native_syscall.o
+ld -r -T ../rem-reloc.ld -o native/rem-runtime.o $objects native/native_syscall.o
+case ${1:-full} in
+seed) echo "Temporary source-built strtod seed ready; remaining libc repairs are not yet built." ;;
+full) echo "All 32 audited libc members rebuilt, with strtod and REM ABI support." ;;
+esac
