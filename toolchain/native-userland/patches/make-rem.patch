--- a/build-native.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/build-native.sh	2026-10-07 08:12:04.543251648 +0100
@@ -0,0 +1,17 @@
+#!/bin/bash
+set -eu
+case $0 in */*) cd "${0%/*}" ;; esac
+source ../../native-env.sh
+mkdir -p native-build native/bin
+cd native-build
+bash ../configure --build=myemulator2-unknown-linux-musl \
+    --prefix="$REM_PREFIX" --disable-nls --without-guile \
+    --disable-posix-spawn CFLAGS="-O0" CPPFLAGS="-Dvfork=fork"
+cp ../build.sh .
+bash build.sh
+cp make ../native/bin/make
+../native/bin/make --version
+../native/bin/make -n -C "$ROOT/packages/bearssl-0.6" \
+    CC="$CC" CFLAGS="-O0 -DBR_NO_ASM=1 -DBR_INT128=0" lib \
+    > bearssl-dry-run.log
+test -s bearssl-dry-run.log
