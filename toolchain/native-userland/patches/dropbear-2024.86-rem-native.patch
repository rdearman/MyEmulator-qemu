--- a/build-native.sh	1970-01-01 00:00:00.000000000 +0000
+++ b/build-native.sh	2026-10-10 00:00:00.000000000 +0000
@@ -0,0 +1,22 @@
+#!/bin/bash
+set -Eeuo pipefail
+ROOT=${REM_USERLAND_ROOT:?REM_USERLAND_ROOT must be exported}
+export REM_USERLAND_ROOT
+PACKAGE_ROOT=$ROOT/packages/dropbear-2024.86
+source "$ROOT/native-env.sh"
+cd "$PACKAGE_ROOT"
+atomic_copy() {
+    source=$1 target=$2
+    mkdir -p "${target%/*}"
+    cp "$source" "$target.tmp"
+    mv -f "$target.tmp" "$target"
+}
+atomic_link() {
+    source=$1 name=$2
+    rm -f "native/bin/$name.tmp"
+    ln -s "$source" "native/bin/$name.tmp"
+    mv -f "native/bin/$name.tmp" "native/bin/$name"
+}
+bash "$ROOT/bootstrap/build-plan-native.sh" "$PACKAGE_ROOT"
+atomic_copy native/bin/dbclient native/bin/ssh
+native/bin/dbclient -V
