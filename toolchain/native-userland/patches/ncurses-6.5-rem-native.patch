--- a/build-native.sh	1970-01-01 01:00:00.000000000 +0100
+++ b/build-native.sh	2026-10-07 11:17:41.568598097 +0100
@@ -0,0 +1,15 @@
+#!/bin/bash
+set -eu
+case $0 in */*) cd "${0%/*}" ;; esac
+source ../../native-env.sh
+bash "$ROOT/bootstrap/build-plan-native.sh" "$PWD"
+mkdir -p "$ROOT/native-deps/include" "$ROOT/native-deps/lib" \
+    "$ROOT/native-deps/share/terminfo"
+cp native-build/include/*.h "$ROOT/native-deps/include/"
+cp native-build/lib/libncurses.a "$ROOT/native-deps/lib/"
+native/bin/tic -x -e ansi,vt100,xterm,xterm-256color,linux \
+    -o "$ROOT/native-deps/share/terminfo" misc/terminfo.src
+mkdir -p "$ROOT/native-tests"
+"$CC" -I"$ROOT/native-deps/include" "$ROOT/tests/vim-terminfo-contracts.c" \
+    -L"$ROOT/native-deps/lib" -lncurses -o "$ROOT/native-tests/vim-terminfo-contracts"
+TERMINFO="$ROOT/native-deps/share/terminfo" "$ROOT/native-tests/vim-terminfo-contracts"
--- a/config.sub	2023-12-27 14:41:27.000000000 +0000
+++ b/config.sub	2026-10-07 00:30:50.960310643 +0100
@@ -1,4 +1,7 @@
 #! /bin/sh
+case ${1-} in
