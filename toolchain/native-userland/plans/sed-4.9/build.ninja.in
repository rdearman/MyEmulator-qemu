cc = @CC@
root = ../../..

rule cc
  command = mkdir -p $directory && rm -f $out.tmp && $cc $flags -c $in -o $out.tmp && mv -f $out.tmp $out
  description = CC $in
rule archive
  command = rm -f $out.tmp && ar rcs $out.tmp $in && mv -f $out.tmp $out
  description = AR $out
rule link
  command = mkdir -p ../native/bin && rm -f $out.partial.o.tmp $out.tmp && ld -r -T $root/bootstrap/rem-reloc.ld -o $out.partial.o.tmp $in && mv -f $out.partial.o.tmp $out.partial.o && $cc -o $out.tmp $out.partial.o $libraries && mv -f $out.tmp $out
  description = LINK $out

build sed/sed-compile.o: cc ../sed/compile.c | config.h lib/stdio.h lib/stdlib.h lib/locale.h lib/wchar.h lib/fcntl.h lib/stdckdint.h lib/langinfo.h lib/stdint.h lib/inttypes.h lib/string.h lib/limits.h lib/wctype.h lib/ctype.h lib/unistd.h lib/time.h sed/version.h lib/selinux/label.h lib/selinux/selinux.h lib/selinux/context.h lib/sys/random.h lib/sys/types.h lib/sys/stat.h lib/malloc/dynarray-skeleton.gl.h lib/malloc/dynarray.gl.h lib/malloc/scratch_buffer.gl.h
  directory = sed
  flags = -DHAVE_CONFIG_H -I. -I.. -I.. -I../lib -Ilib -Ised '-DLOCALEDIR="/home/dev/.local/share/locale"' -O0
