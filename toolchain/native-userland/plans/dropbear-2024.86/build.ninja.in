cc = @CC@
root = ../../..

rule cc
  command = mkdir -p $directory && $cc $flags -c $in -o $out
  description = CC $in
rule archive
  command = ar rcs $out $in
  description = AR $out
rule link
  command = mkdir -p ../native/bin && ld -r -T $root/bootstrap/rem-reloc.ld -o $out.partial.o $in && $cc -o $out $out.partial.o $libraries
  description = LINK $out

build libtommath/bn_cutoffs.o: cc ../libtommath/bn_cutoffs.c | default_options_guard.h localoptions.h config.h
  directory = libtommath
  flags = -I../libtommath -Ilibtomcrypt/src/headers -I../libtommath/../libtomcrypt/src/headers/ -I. -I../libtommath/../src -Ilibtommath
