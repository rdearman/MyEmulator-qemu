cc = @CC@
root = ../../..

rule cc
  command = mkdir -p $directory && $cc $flags -c $in -o $out
  description = CC $in
rule archive
  command = ar rcs $out $in
  description = AR $out
rule link
  command = mkdir -p ../native/bin && ld -r -T $root/bootstrap/rem-reloc.ld -o $out.partial.o $in && $cc -o $out $out.partial.o $libraries
  description = LINK $out

build src/liblzma/liblzma_la-tuklib_physmem.o: cc ../src/liblzma/../common/tuklib_physmem.c | config.h
  directory = src/liblzma
  flags = -DHAVE_CONFIG_H -Isrc/liblzma -I../src/liblzma -I. -I../src/liblzma/api -I../src/liblzma/common -I../src/liblzma/check -I../src/liblzma/lz -I../src/liblzma/rangecoder -I../src/liblzma/lzma -I../src/liblzma/delta -I../src/liblzma/simple -I../src/common -DTUKLIB_SYMBOL_PREFIX=lzma_ -O0
build src/liblzma/liblzma_la-common.o: cc ../src/liblzma/common/common.c | config.h
  directory = src/liblzma
  flags = -DHAVE_CONFIG_H -Isrc/liblzma -I../src/liblzma -I. -I../src/liblzma/api -I../src/liblzma/common -I../src/liblzma/check -I../src/liblzma/lz -I../src/liblzma/rangecoder -I../src/liblzma/lzma -I../src/liblzma/delta -I../src/liblzma/simple -I../src/common -DTUKLIB_SYMBOL_PREFIX=lzma_ -O0
