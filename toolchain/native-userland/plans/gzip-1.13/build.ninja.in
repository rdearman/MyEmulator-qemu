cc = @CC@
root = ../../..

rule cc
  command = mkdir -p $directory && $cc $flags -c $in -o $out
  description = CC $in
rule archive
  command = ar rcs $out $in
  description = AR $out
rule link
  command = mkdir -p ../native/bin && ld -r -T $root/bootstrap/rem-reloc.ld -o $out.partial.o $in && $cc -o $out $out.partial.o $libraries
  description = LINK $out

build lib/libgzip_a-openat-proc.o: cc ../lib/openat-proc.c | version.h lib/stdio.h lib/signal.h lib/getopt-cdefs.h lib/stdlib.h lib/wchar.h lib/stddef.h lib/utime.h lib/fcntl.h lib/stdckdint.h lib/math.h lib/stdint.h lib/config.h lib/inttypes.h lib/string.h lib/getopt.h lib/limits.h lib/dirent.h lib/unistd.h lib/error.h lib/time.h lib/sys/types.h lib/sys/stat.h lib/sys/time.h
  directory = lib
  flags = -DHAVE_CONFIG_H -Ilib -I../lib -O0
