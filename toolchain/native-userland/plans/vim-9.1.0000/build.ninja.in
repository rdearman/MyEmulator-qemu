cc = @CC@
root = ../../..

rule cc
  command = mkdir -p $directory && $cc $flags -c $in -o $out
  description = CC $in
rule archive
  command = ar rcs $out $in
  description = AR $out
rule link
  command = mkdir -p ../native/bin && ld -r -T $root/bootstrap/rem-reloc.ld -o $out.partial.o $in && $cc -o $out $out.partial.o $libraries
  description = LINK $out

build objects/alloc.o: cc ../src/alloc.c | auto/osdef.h auto/config.h
  directory = objects
  flags = -I../src -I../src/proto -DHAVE_CONFIG_H -I@REM_DEPS@/include -I. -O0 -D_REENTRANT
