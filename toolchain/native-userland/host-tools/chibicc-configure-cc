export CHIBICC_REM_AS="$repo/.toolchain-install/bin/myemulator2-elf-as"
export CHIBICC_REM_LD="$repo/.toolchain-install/bin/myemulator2-elf-ld"
export CHIBICC_REM_LINKER_SCRIPT="$repo/toolchain/userspace/myemulator2-user.ld"
