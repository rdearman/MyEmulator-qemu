# REM 0.1 release baseline: console, ext4 userspace, and QEMU virtio-mmio NIC.
CONFIG_MYEMULATOR2=y
CONFIG_64BIT=n
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_EXPERT=y
CONFIG_HZ_100=y
CONFIG_COMPACTION=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLOCK=y
CONFIG_MYEMU2_BLOCK=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_SERIAL_8250=n
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEFAULT_HOSTNAME="myemulator2"
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyMY0,115200 earlycon=myemulator2,0xf0000000 root=/dev/myemu0 rw init=/sbin/init ip=off"
CONFIG_CMDLINE_FORCE=y
CONFIG_MODULES=n

# QEMU user-mode networking through the REM virtio-mmio machine model.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_NET=y

CONFIG_SOUND=n
CONFIG_USB=n
CONFIG_INPUT=n
CONFIG_VT=n
CONFIG_HID=n
CONFIG_FW_LOADER=n
CONFIG_HW_RANDOM=n
