CONFIG_MYEMULATOR2=y
CONFIG_64BIT=n
CONFIG_SMP=n
CONFIG_PREEMPT_NONE=y
CONFIG_EXPERT=y
CONFIG_HZ_100=y
# The 16 MiB REM machine has no migration/compaction implementation.
# Generic kcompactd otherwise attempts to install migration PTEs using
# unsupported page-state paths and corrupts user mappings under shell load.
# Keep the stable single-node kernel configuration non-compacting.
# CONFIG_COMPACTION is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLOCK=y
CONFIG_MYEMU2_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BINFMT_ELF=y
CONFIG_SERIAL_8250=n
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEFAULT_HOSTNAME="myemulator2"
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyMY0,115200 earlycon=myemulator2,0xf0000000 root=/dev/myemu0 rw init=/sbin/init ip=off virtio_mmio.device=0x200@0xf0200000:5"
CONFIG_CMDLINE_FORCE=y
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
# CONFIG_KALLSYMS is not set
CONFIG_MODULES=n
# QEMU user networking uses the MyEmulator32 virtio-mmio NIC.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_SOUND=n
CONFIG_USB=n
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_HID is not set
# CONFIG_FW_LOADER is not set
# CONFIG_HW_RANDOM is not set
